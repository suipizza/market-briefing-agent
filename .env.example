# 복사해서 .env로 저장하고 값을 채운다. .env는 커밋하지 않는다.

# SoSoValue 무료 API 키 (ETF 순유입)
SOSOVALUE_API_KEY=

# 노션 integration 토큰과 대상 DB의 data source ID
# data source ID는 scripts/setup_notion_db.py가 출력한다
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=

# (선택) claude CLI 경로. 비우면 PATH와 ~/.local/bin에서 찾는다
CLAUDE_BIN=
# (선택) LLM 모델. 비우면 CLI 기본 모델
LLM_MODEL=
